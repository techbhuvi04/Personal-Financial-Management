# Copy to .env (git-ignored) and fill in real values. Never commit real credentials.

# Database: either a full JDBC URL ...
DB_URL=jdbc:postgresql://localhost:5432/finance
# ... or host/port/name (DB_URL takes precedence when set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=finance
DB_USERNAME=finance
DB_PASSWORD=change-me
DB_POOL_MAX_SIZE=5

# HTTP
PORT=8080
SPRING_PROFILES_ACTIVE=local

# Session cookie: keep COOKIE_SECURE=true whenever the app is served over HTTPS
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
SESSION_TIMEOUT=30m

# Business rules
APP_TIME_ZONE=UTC

# Require X-XSRF-TOKEN on state-changing requests (browser clients). See README "CSRF".
CSRF_ENABLED=false

# Swagger UI / OpenAPI docs
API_DOCS_ENABLED=true
